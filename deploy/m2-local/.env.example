# M2 local configuration-check example.
# These values are intentionally non-production. Do not use the example secrets
# or example domain on a real VPS.

BASE_DOMAIN=dsh.example.test
PORTAL_HOST=dsh.example.test
CONTROL_HOST=control.dsh.example.test
AUTH_HOST=auth.dsh.example.test
INSTANCE_BASE_DOMAIN=instances.dsh.example.test
PUBLIC_SCHEME=https

# Caddy / ACME. For local config rendering only; real VPS needs a real email and
# public DNS. Wildcard certificates require DNS-01 provider configuration.
ACME_EMAIL=admin@example.test

# Docker Compose assigns the bridge subnet automatically to avoid conflicts with
# existing local Docker networks. The service trusts identity headers from the
# standard Docker private range only in this compose deployment.
TRUSTED_PROXY_CIDRS=172.16.0.0/12
TRUSTED_USER_HEADER=remote-user

CURRENT_TOKEN_PEPPER_KEY_ID=m2-local
CURRENT_IDEMPOTENCY_ENCRYPTION_KEY_ID=m2-local

# These files contain deliberately insecure example values so `docker compose
# config` can render locally. Replace them with generated secrets on VPS.
TOKEN_PEPPER_KEYRING_SECRET_FILE=./secrets/token-pepper-keyring.example.json
IDEMPOTENCY_ENCRYPTION_KEYRING_SECRET_FILE=./secrets/idempotency-encryption-keyring.example.json
DSH_HUB_PROXY_KEY_SECRET_FILE=./secrets/proxy-key.example.txt

# Authelia example config is for static validation only. Replace all secrets and
# user database before any real deployment.
AUTHELIA_JWT_SECRET_FILE=./secrets/authelia-jwt.example.txt
AUTHELIA_SESSION_SECRET_FILE=./secrets/authelia-session.example.txt
AUTHELIA_STORAGE_ENCRYPTION_KEY_FILE=./secrets/authelia-storage.example.txt
