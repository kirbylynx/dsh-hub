# Example only. Replace before running a real deployment.
# Generate a real hash on the VPS with:
#   docker run --rm authelia/authelia:4 authelia crypto hash generate argon2 --password '<password>'
users:
  m2local:
    displayname: "M2 Local Example"
    # Deliberately invalid placeholder: this file is for config rendering only.
    password: "$argon2id$v=19$m=65536,t=3,p=4$replace-me$replace-me"
    email: m2local@example.test
    groups:
      - dsh-hub-users
