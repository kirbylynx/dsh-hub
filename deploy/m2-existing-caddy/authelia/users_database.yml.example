# Example only. Copy to users_database.yml on the VPS and replace the password
# hash before running a real deployment.
# Generate a real hash on the VPS with:
#   docker run --rm authelia/authelia:4 authelia crypto hash generate argon2 --password '<password>'
users:
  owner:
    displayname: "DSH Hub Owner"
    # Deliberately invalid placeholder: replace before production.
    password: "$argon2id$v=19$m=65536,t=3,p=4$replace-me$replace-me"
    email: owner@hub.example.com
    groups:
      - dsh-hub-users
