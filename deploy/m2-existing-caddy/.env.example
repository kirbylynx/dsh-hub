# M2 VPS deployment profile for an existing system Caddy.
# Target server: Caddy already owns public 80/443. Docker Compose must not bind
# public ports or start another Caddy.

BASE_DOMAIN=hub.example.com
PORTAL_HOST=hub.example.com
CONTROL_HOST=control.hub.example.com
AUTH_HOST=auth.hub.example.com
INSTANCE_BASE_DOMAIN=instances.hub.example.com
PUBLIC_SCHEME=https

# Loopback-only backend ports used by the existing system Caddy.
DSH_HUB_SERVICE_BIND_PORT=18081
AUTHELIA_BIND_PORT=19091
LLDAP_LDAP_BIND_PORT=3890
LLDAP_HTTP_BIND_PORT=17170

# Caddy connects from localhost in host-network mode.
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
TRUSTED_USER_HEADER=remote-user

CURRENT_TOKEN_PEPPER_KEY_ID=example-key-1
CURRENT_IDEMPOTENCY_ENCRYPTION_KEY_ID=example-key-1

# Replace example files with generated production secrets on the VPS.
TOKEN_PEPPER_KEYRING_SECRET_FILE=./secrets/token-pepper-keyring.example.json
IDEMPOTENCY_ENCRYPTION_KEYRING_SECRET_FILE=./secrets/idempotency-encryption-keyring.example.json

# Replace Authelia/LLDAP example secrets before production use.
AUTHELIA_JWT_SECRET_FILE=./secrets/authelia-jwt.example.txt
AUTHELIA_SESSION_SECRET_FILE=./secrets/authelia-session.example.txt
AUTHELIA_STORAGE_ENCRYPTION_KEY_FILE=./secrets/authelia-storage.example.txt
LLDAP_JWT_SECRET_FILE=./secrets/lldap-jwt.example.txt
LLDAP_KEY_SEED_FILE=./secrets/lldap-key-seed.example.txt
LLDAP_ADMIN_PASSWORD_FILE=./secrets/lldap-admin-password.example.txt
LLDAP_BASE_DN=dc=dsh,dc=hub
LLDAP_ADMIN_USERNAME=admin
LLDAP_ADMISSION_GROUP=dsh-hub-users
