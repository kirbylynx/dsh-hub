# Example only. Copy to .env in a private deployment directory and edit values.

# Logical hosted instance identifier. Use one directory per instance.
DSH_HOSTED_INSTANCE_ID=dsh-0001

# Host-side root. The compose file stores this instance below:
#   ${DSH_HOST_DATA_ROOT}/${DSH_HOSTED_INSTANCE_ID}/
DSH_HOST_DATA_ROOT=/data/docker

# Hub connection settings. These are not secrets, but real deployment values
# should still live outside the public repository.
DSH_HUB_ENDPOINT=https://control.hub.example.com
DSH_HUB_NAMESPACE=my-team
DSH_HUB_INSTANCE_NAME=hosted-dsh-0001

# First G11 pilot pins the DSH version verified by the v0.1.0 plugin baseline.
DSH_VERSION=0.1.0-rc.7

# Container resource guardrails for a manually managed hosted instance.
DSH_HOSTED_CPUS=2.0
DSH_HOSTED_MEMORY_LIMIT=2g
DSH_HOSTED_PIDS_LIMIT=512
DSH_HOSTED_TMPFS_SIZE=256m
